---
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "Experience", href: "/experience" },
  { label: "Projects", href: "/projects" },
  { label: "Honors", href: "/honors" },
  { label: "Links", href: "/links" },
];
---

<nav
  id="nav-header"
  class="fixed top-0 left-0 right-0 z-50 transition-transform duration-500"
>
  <div
    class="bg-background/60 backdrop-blur-xl border-b border-white/5"
  >
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
      <!-- Left: Back Button -->
      <a
        href="/"
        class="flex items-center gap-2 text-muted hover:text-accent transition-colors duration-300 cursor-hover group"
      >
        <Icon
          name="hugeicons:arrow-left-02"
          class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-300"
        />
        <span class="font-mono text-xs uppercase tracking-wider hidden sm:inline"
          >Home</span
        >
      </a>

      <!-- Center: Wordmark -->
      <a
        href="/"
        class="font-black text-2xl tracking-tighter text-foreground hover:text-foreground/80 transition-colors duration-300 cursor-hover"
      >
        tam<span class="text-accent tracking-normal">.</span>
      </a>

      <!-- Right: Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-6">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class={`font-mono text-xs uppercase tracking-wider transition-colors duration-300 cursor-hover ${
                currentPath.startsWith(link.href)
                  ? "text-accent"
                  : "text-muted hover:text-foreground"
              }`}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Right: Mobile Hamburger -->
      <button
        id="nav-toggle"
        class="md:hidden flex flex-col gap-1.5 cursor-hover p-1"
        aria-label="Toggle menu"
      >
        <span
          class="block w-5 h-px bg-foreground transition-all duration-300 origin-center"
          id="hamburger-top"></span>
        <span
          class="block w-5 h-px bg-foreground transition-all duration-300"
          id="hamburger-mid"></span>
        <span
          class="block w-3 h-px bg-foreground transition-all duration-300 origin-center ml-auto"
          id="hamburger-bot"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 top-[57px] bg-background/95 backdrop-blur-2xl z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-500"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class={`font-mono text-sm uppercase tracking-[0.2em] transition-colors duration-300 cursor-hover ${
            currentPath.startsWith(link.href)
              ? "text-accent"
              : "text-muted hover:text-foreground"
          }`}
        >
          {link.label}
        </a>
      ))
    }
    <hr class="w-12 border-white/10" />
    <a
      href="/"
      class="font-mono text-xs uppercase tracking-wider text-textAccent hover:text-accent transition-colors duration-300 cursor-hover"
    >
      ← Back to Home
    </a>
  </div>
</nav>

<!-- Spacer to prevent content from going under the fixed nav -->
<div class="h-[57px]"></div>

<script>
  const initNav = () => {
    const toggle = document.getElementById("nav-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerTop = document.getElementById("hamburger-top");
    const hamburgerMid = document.getElementById("hamburger-mid");
    const hamburgerBot = document.getElementById("hamburger-bot");
    const navHeader = document.getElementById("nav-header");

    if (!toggle || !mobileMenu || !navHeader) return;

    let isOpen = false;

    toggle.addEventListener("click", () => {
      isOpen = !isOpen;

      if (isOpen) {
        mobileMenu.classList.remove("opacity-0", "pointer-events-none");
        mobileMenu.classList.add("opacity-100", "pointer-events-auto");
        hamburgerTop?.classList.add("rotate-45", "translate-y-[4px]");
        hamburgerMid?.classList.add("opacity-0");
        hamburgerBot?.classList.add(
          "-rotate-45",
          "-translate-y-[4px]",
          "w-5",
          "ml-0"
        );
      } else {
        mobileMenu.classList.add("opacity-0", "pointer-events-none");
        mobileMenu.classList.remove("opacity-100", "pointer-events-auto");
        hamburgerTop?.classList.remove("rotate-45", "translate-y-[4px]");
        hamburgerMid?.classList.remove("opacity-0");
        hamburgerBot?.classList.remove(
          "-rotate-45",
          "-translate-y-[4px]",
          "w-5",
          "ml-0"
        );
      }
    });

    // Hide/show nav on scroll
    let lastScrollY = 0;
    let ticking = false;

    const updateNav = () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY > lastScrollY && currentScrollY > 100) {
        // Scrolling down & past threshold
        navHeader.style.transform = "translateY(-100%)";
      } else {
        // Scrolling up
        navHeader.style.transform = "translateY(0)";
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(updateNav);
        ticking = true;
      }
    });
  };

  document.addEventListener("DOMContentLoaded", initNav);
</script>
