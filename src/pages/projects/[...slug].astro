---
import SubLayout from "@/layouts/sub/sub.layout.astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Get all projects sorted for prev/next navigation
const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allProjects.findIndex((p) => p.id === project.id);
const prevProject =
  currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject =
  currentIndex < allProjects.length - 1
    ? allProjects[currentIndex + 1]
    : null;
---

<SubLayout
  title={`${project.data.title} — Projects — Ibrahim Sadik Tamim`}
  description={project.data.description}
  url={`https://tam11a.dev/projects/${project.id}`}
>
  <!-- Hero -->
  <header class="pt-20 pb-32 md:pb-52 min-h-[55vh] md:min-h-[60vh] flex flex-col justify-end">
    <a href="/projects" class="font-mono text-textAccent text-sm font-semibold mb-6 reveal-text hover:text-accent transition-colors duration-300 cursor-hover w-fit">
      # PRJ
    </a>
    <h1
      class="font-black text-6xl md:text-9xl tracking-tighter text-foreground leading-none reveal-text"
    >
      {project.data.title}<span class="text-accent tracking-normal">.</span>
    </h1>
    <div class="mt-8 text-xl md:text-2xl text-muted max-w-3xl leading-relaxed reveal-text">
      {project.data.description}
    </div>

    <!-- Tags -->
    {
      project.data.tags && (
        <div class="flex flex-wrap gap-2 mt-8">
          {project.data.tags.map((tag: string) => (
            <span class="text-xs font-mono text-textAccent px-3 py-1 rounded-full border border-white/5 reveal-pop">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- External Link -->
    {
      project.data.link && project.data.link !== "#" && (
        <div class="mt-8">
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-accent hover:text-accent/80 transition-colors duration-300 font-mono text-sm uppercase tracking-wider cursor-hover group reveal-text"
          >
            View Project
            <Icon
              name="hugeicons:arrow-up-right-03"
              class="w-4 h-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300"
            />
          </a>
        </div>
      )
    }
  </header>

  <!-- Content -->
  <hr class="animated-separator mb-12" />
  <div class="prose max-w-3xl mb-24">
    <Content />
  </div>

  <!-- Prev/Next Navigation -->
  <hr class="animated-separator mb-12" />
  <div class="grid md:grid-cols-2 gap-8 mb-24">
    {
      prevProject ? (
        <a
          href={`/projects/${prevProject.id}`}
          class="group cursor-hover block"
        >
          <span class="text-xs font-mono text-textAccent uppercase tracking-wider reveal-text">
            ← Previous
          </span>
          <p class="text-xl font-bold text-foreground group-hover:text-accent transition-colors duration-300 mt-2 reveal-text">
            {prevProject.data.title}
          </p>
        </a>
      ) : (
        <div />
      )
    }
    {
      nextProject && (
        <a
          href={`/projects/${nextProject.id}`}
          class="group cursor-hover block text-right"
        >
          <span class="text-xs font-mono text-textAccent uppercase tracking-wider reveal-text">
            Next →
          </span>
          <p class="text-xl font-bold text-foreground group-hover:text-accent transition-colors duration-300 mt-2 reveal-text">
            {nextProject.data.title}
          </p>
        </a>
      )
    }
  </div>
</SubLayout>
