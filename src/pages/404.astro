---
import MainLayout from "@/layouts/main/main.layout.astro";
import { Icon } from "astro-icon/components";
---

<MainLayout>
  <header
    class="pt-20 pb-32 md:pb-52 min-h-[55vh] md:min-h-[60vh] flex flex-col justify-end"
  >
    <p class="font-mono text-textAccent text-sm font-semibold mb-6 reveal-text">
      # 404
    </p>
    <h1
      class="font-black text-6xl md:text-9xl tracking-tighter text-foreground leading-[0.9] reveal-text"
    >
      oops<span class="text-accent tracking-normal">.</span>
    </h1>
    <div class="mt-8 text-lg text-muted max-w-xl leading-relaxed reveal-text">
      The page you're looking for doesn't exist. It might have been moved or
      deleted. Don't worry, you can always head back to the homepage and explore
      from there.
    </div>

    <div class="flex flex-col space-y-4 mt-16">
      {
        [
          {
            label: "Home.",
            link: "/",
          },
          {
            label: "Works.",
            link: "/works",
          },
          {
            label: "Projects.",
            link: "/projects",
          },
          {
            label: "Articles.",
            link: "/articles",
          },
        ].map((ref_link) => (
          <a href={ref_link.link} class="group block cursor-hover relative">
            <div class="flex items-center justify-between pb-6">
              <span class="text-muted group-hover:text-accent transition font-mono text-sm uppercase tracking-wider reveal-text">
                {ref_link.label}
              </span>
              <span class="text-muted group-hover:text-accent transition flex items-center gap-3 font-mono text-sm reveal-text">
                {ref_link.link}{" "}
                <Icon
                  name={"hugeicons:arrow-up-right-03"}
                  class="w-4 h-4 reveal-arrow"
                />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </header>
</MainLayout>
