---
import SubLayout from "@/layouts/sub/sub.layout.astro";
import { Icon } from "astro-icon/components";

const links = [
  {
    label: "Mail",
    value: "ibrahimsadiktamim@gmail.com",
    href: "mailto:ibrahimsadiktamim@gmail.com",
    icon: "hugeicons:mail-01",
  },
  {
    label: "GitHub",
    value: "tam11a",
    href: "https://github.com/tam11a",
    icon: "simple-icons:github",
  },
  {
    label: "LinkedIn",
    value: "tam11a",
    href: "https://www.linkedin.com/in/tam11a",
    icon: "simple-icons:linkedin",
  },
  {
    label: "Dribbble",
    value: "tam11a",
    href: "https://dribbble.com/tam11a",
    icon: "simple-icons:dribbble",
  },
  {
    label: "YouTube",
    value: "@tam11a-dev",
    href: "https://www.youtube.com/@tam11a-dev",
    icon: "simple-icons:youtube",
  },
  {
    label: "Instagram",
    value: "tam11a",
    href: "https://www.instagram.com/tam11a",
    icon: "simple-icons:instagram",
  },
];
---

<SubLayout
  title="Links — Ibrahim Sadik Tamim"
  description="Connect with Ibrahim Sadik Tamim across the web."
  url="https://tam11a.dev/links"
  footerNav={false}
>
  <!-- Hero -->
  <header class="pt-20 pb-32 min-h-[55vh] md:min-h-[60vh] flex flex-col justify-end">
    <a href="/" class="font-mono text-textAccent text-sm font-semibold mb-6 reveal-text hover:text-accent transition-colors duration-300 cursor-hover w-fit">
      # LNK
    </a>
    <h1
      class="font-black text-6xl md:text-9xl tracking-tighter text-foreground leading-[0.9] reveal-text"
    >
      tam<span class="text-accent tracking-normal">.</span>
    </h1>
    <div class="mt-8 text-xl md:text-2xl text-muted max-w-2xl leading-relaxed reveal-text">
      Coder ✦ Designer ✦ Thinker — Currently bringing ideas to life at <a
        href="https://definedsolution.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:underline cursor-hover">@definedsolution</a
      >
    </div>
  </header>

  <!-- Links Grid -->
  <div class="max-w-lg mx-auto space-y-3 mb-16">
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("mailto") ? undefined : "_blank"}
          rel={
            link.href.startsWith("mailto")
              ? undefined
              : "noopener noreferrer"
          }
          class="group block cursor-hover"
        >
          <div class="flex items-center gap-4 px-6 py-4 rounded-xl border border-white/5 bg-white/2 hover:border-accent/30 hover:bg-accent/3 transition-all duration-500 group-hover:scale-[1.02]">
            <Icon
              name={link.icon}
              class="w-5 h-5 text-muted group-hover:text-accent transition-colors duration-300 shrink-0"
            />
            <div class="flex-1 min-w-0">
              <span class="font-mono text-xs text-textAccent uppercase tracking-wider reveal-text">
                {link.label}
              </span>
              <p class="text-foreground text-sm truncate group-hover:text-accent transition-colors duration-300 reveal-text">
                {link.value}
              </p>
            </div>
            <Icon
              name="hugeicons:arrow-up-right-03"
              class="w-4 h-4 text-muted/30 group-hover:text-accent transition-all duration-300 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0"
            />
          </div>
        </a>
      ))
    }
    </div>
  </div>
</SubLayout>
